pipeline {

    agent {
        label 'docker'  // <--- Aquí especificas el nodo por su etiqueta
    }

    environment {
        SONAR_HOST_URL = 'http://24.199.111.45:9000'      // URL de tu SonarQube
        SONAR_TOKEN = credentials('sonar-token-id')   // Usar "Secret Text" en Jenkins
    }
    
    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQubeServer') {  // Nombre del server configurado en Jenkins
                    sh 'mvn clean verify sonar:sonar -Ddependency-check.skip=true -Dsonar.projectKey=simple-java-maven-app -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.token=$SONAR_TOKEN'
                }
            }
        }
        
        stage('Build') {
            steps {
                sh 'mvn -B -DskipTests clean package'
            }
        }
        
        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        
        /**stage('Vulnerability Analysis') {
            steps {
                sh 'mvn org.owasp:dependency-check-maven:check'
            }
        }**/
        
        stage('Build Docker Image') {
    	    steps {
        	script {
            	// Copiar el artefacto si es necesario
		sh 'cp target/*.jar dockerfile/'

            	sh 'cd dockerfile/'

            	// Construir la imagen Docker
            	sh 'docker build -f dockerfile/Dockerfile -t my-app-image .'

		sh 'cd ..'

            	// Publicar la imagen en Docker Hub
            	//sh 'docker login -u $DOCKER_USERNAME -p $DOCKER_PASSWORD'
            	//sh 'docker tag my-app-image $DOCKER_USERNAME/my-app-image:latest'
            	//sh 'docker push $DOCKER_USERNAME/my-app-image:latest'
                }
    	    }
	    }

        stage('Deliver') {
            steps {
                sh './jenkins/scripts/deliver.sh' 
            }
        }

    }
}
