pipeline
{

agent { Label "server-1"}

tools { Maven "maven-3.9.16" }

stages{

stage ("build"){

steps{
    sh "mvn clean package"

}
 post{

success {

    archiveArtifact artifacts: '**/target/*.war'

    echo "build is successful"
}



 }

}

stage("test"){

    steps{
        echo "this is a test stage"
    }
    
}

stage('DEPLOY"' )
{

steps{
    echo "this is deploy stage"
}

}







}














}